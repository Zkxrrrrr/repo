# Copy to .env and fill in.

# --- Captcha (chain) -------------------------------------------------------
# Comma-separated provider:key pairs. Tried in order, falls back on failure.
# Supported providers: 2captcha, capsolver, anti-captcha
CAPTCHA_CHAIN=2captcha:KEY1,capsolver:KEY2

# Legacy single-provider knobs (used only if CAPTCHA_CHAIN is empty)
CAPTCHA_PROVIDER=2captcha
CAPTCHA_API_KEY=

# --- SMS verification ------------------------------------------------------
SMS_PROVIDER=5sim
SMS_API_KEY=

# --- Email -----------------------------------------------------------------
EMAIL_PROVIDER=mailtm

# --- Proxies ---------------------------------------------------------------
# Newline or comma separated http(s)/socks5 URIs
# e.g. http://user:pass@host:port
PROXIES=

# --- Notifications ---------------------------------------------------------
DISCORD_WEBHOOK=

# --- Browser ---------------------------------------------------------------
HEADLESS=true
